# ========================================================
# CAMPUSVOICE ENVIRONMENT CONFIGURATION
# ========================================================

# Application Mode (local, production)
APP_ENV=local

# Java Application Server Ports & Service Config
JAVA_APP_TITLE=CampusVoice
JAVA_APP_VERSION=1.0.0

# Supabase / PostgreSQL Database Connection
SUPABASE_DB_URL=jdbc:postgresql://db.xxx.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_supabase_db_password

# Supabase API & Storage Configuration
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_STORAGE_BUCKET=campusvoice-attachments

# Python FastAPI AI Microservice URL
AI_SERVICE_URL=http://localhost:8000

# AI Model & Confidence Settings
AI_CONFIDENCE_THRESHOLD=0.75

# Escalation SLA Settings (Hours)
SLA_HIGH_PRIORITY_HOURS=24
SLA_MEDIUM_PRIORITY_HOURS=48
SLA_LOW_PRIORITY_HOURS=96
